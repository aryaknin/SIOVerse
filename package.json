{
  "name": "sioverse",
  "version": "1.0.0",
  "description": "Le bureau numérique des étudiants SIO",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.mjs",
