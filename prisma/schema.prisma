generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResourceKind {
  COURSE
  EXERCISE
  CORRECTION
  CHEATSHEET
  LINK
}

enum ControlStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum Universe {
  LORE
  MEMES
  UNDERCOVER
  MAKE_IT_SIO
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  posts     Post[]
}

model Subject {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  color     String
  chapters Chapter[]
  events    Event[]
  controls  Control[]
}

model Chapter {
  id          String     @id @default(cuid())
  title       String
  position    Int        @default(0)
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resources   Resource[]
  controls    Control[]

  @@unique([subjectId, position])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  kind        ResourceKind
  storagePath String?
  externalUrl String?
  chapterId   String
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
}

model Control {
  id          String        @id @default(cuid())
  title       String
  scheduledAt DateTime
  status      ControlStatus @default(UPCOMING)
  room        String?
  subjectId   String
  chapterId   String?
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter     Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  endsAt      DateTime
  room        String?
  sourceUid   String?  @unique
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model Post {
  id        String   @id @default(cuid())
  content   String
  imagePath String?
  universe  Universe @default(MEMES)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ENT catalogue. The imported files remain in storage/ent/files; PostgreSQL
// stores their classification, hierarchy, teachers and document metadata.
model EntSubject {
  id          String          @id @db.Uuid
  name        String          @unique
  teacher     String
  color       String
  createdAt   DateTime        @map("created_at") @db.Timestamptz(6)
  chapters    EntChapter[]
  assessments EntAssessment[]

  @@map("ent_subjects")
}

model EntChapter {
  id              String                 @id @db.Uuid
  subjectId       String                 @map("subject_id") @db.Uuid
  parentId        String?                @map("parent_id") @db.Uuid
  title           String
  position        Int
  subject         EntSubject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent          EntChapter?            @relation("EntChapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        EntChapter[]           @relation("EntChapterTree")
  resources       EntResource[]
  assessmentLinks EntAssessmentChapter[]

  @@unique([subjectId, parentId, title])
  @@index([subjectId])
  @@map("ent_chapters")
}

model EntResource {
  id           String     @id @db.Uuid
  chapterId    String     @map("chapter_id") @db.Uuid
  title        String
  kind         String
  teacher      String
  originalName String?    @map("original_name")
  mimeType     String?    @map("mime_type")
  storedName   String?    @map("stored_name")
  externalUrl  String?    @map("external_url")
  sourceKey    String?    @unique @map("source_key")
  createdAt    DateTime   @map("created_at") @db.Timestamptz(6)
  chapter      EntChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("ent_resources")
}

model EntAssessment {
  id          String                 @id @db.Uuid
  kind        String
  title       String
  subjectId   String                 @map("subject_id") @db.Uuid
  scheduledAt DateTime               @map("scheduled_at") @db.Timestamptz(6)
  details     String
  room        String
  createdAt   DateTime               @map("created_at") @db.Timestamptz(6)
  subject     EntSubject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters    EntAssessmentChapter[]

  @@map("ent_assessments")
}

model EntAssessmentChapter {
  assessmentId String        @map("assessment_id") @db.Uuid
  chapterId    String        @map("chapter_id") @db.Uuid
  assessment   EntAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  chapter      EntChapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([assessmentId, chapterId])
  @@map("ent_assessment_chapters")
}
